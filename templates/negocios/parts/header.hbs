<header class="t20b-header">
  <img class="t20b-retrato" src="{{actor.img}}" alt="{{actor.name}}" data-action="editarImagem" title="Trocar imagem">
  <div class="t20b-header-info">
    <input class="t20b-nome" type="text" name="name" value="{{actor.name}}" placeholder="Nome do negócio">
    <div class="t20b-linha-status">
      {{#if system.ramo}}<span class="t20b-chip"><i class="fa-solid fa-store"></i> {{system.ramo}}</span>{{/if}}
      <span class="t20b-chip" title="{{system.categoria.desc}}">
        <i class="fa-solid fa-signal"></i>
        {{#if system.fundado}}Nível {{system.nivel}} · {{system.categoria.nome}}{{else}}Não fundado{{/if}}
      </span>
      <span class="t20b-chip" title="Um ativo por nível"><i class="fa-solid fa-cubes"></i> Ativos {{system.qtdAtivos}}/{{system.maxAtivos}}</span>
      {{#if system.fundado}}<span class="t20b-chip" title="Rendimento básico por mês/aventura"><i class="fa-solid fa-sack-dollar"></i> {{rendimentoFmt}}/mês</span>{{/if}}
      {{#if donoNome}}<span class="t20b-chip" title="Dono do negócio"><i class="fa-solid fa-crown"></i> {{donoNome}}</span>{{/if}}
      <button type="button" class="t20b-chip t20b-chip-botao" data-action="ajustarCaixa" title="Caixa do negócio — clique para ajustar">
        <i class="fa-solid fa-coins"></i> {{caixaFmt}}
      </button>
    </div>
  </div>
</header>
