<section class="t20b-aba" data-tab="inventario">
  <div class="t20b-inventario">
    <div class="t20b-inv-moedas">
      <span class="t20b-inv-moedas-titulo"><i class="fa-solid fa-coins"></i> Caixa do Negócio</span>
      <label title="Tibar de ouro (vale T$ 10)">TO
        <input type="number" name="system.dinheiro.to" value="{{system.dinheiro.to}}" min="0" step="1"></label>
      <label title="Tibar (moeda de prata)">T$
        <input type="number" name="system.dinheiro.tp" value="{{system.dinheiro.tp}}" min="0" step="1"></label>
      <label title="Tibar de cobre (vale T$ 0,1)">TC
        <input type="number" name="system.dinheiro.tc" value="{{system.dinheiro.tc}}" min="0" step="1"></label>
      <span class="t20b-inv-moedas-total" title="Valor total das moedas do negócio">= {{totalMoedas}}</span>
    </div>

    {{#each inventario}}
    <div class="t20b-inv-grupo">
      <header class="t20b-inv-cab">
        <span class="t20b-inv-titulo"><i class="fa-solid {{icone}}"></i> {{rotulo}} <span class="t20b-inv-cont">{{itens.length}}</span></span>
        <span class="t20b-inv-col-qtd">Qtd</span>
        <span class="t20b-inv-col-preco" title="Espaços por unidade / total">Peso</span>
        <span class="t20b-inv-col-acoes"></span>
      </header>
      <ol class="t20b-inv-lista">
        {{#each itens}}
        <li class="t20b-inv-linha" data-id="{{id}}">
          <img src="{{img}}" alt="">
          <a class="t20b-inv-nome" data-action="abrirItem" data-id="{{id}}">{{nome}}</a>
          {{#if @root.editable}}
          <input class="t20b-inv-qtd" type="number" data-id="{{id}}" value="{{qtd}}" min="0" step="1" title="Quantidade">
          {{else}}
          <span class="t20b-inv-qtd">{{qtd}}</span>
          {{/if}}
          <span class="t20b-inv-preco">{{pesoFmt}}</span>
          <span class="t20b-inv-acoes">
            {{#if @root.editable}}
            <a class="t20b-perigo" data-action="excluirItem" data-id="{{id}}" title="Excluir do estoque"><i class="fa-solid fa-trash"></i></a>
            {{/if}}
          </span>
        </li>
        {{else}}
        <li class="t20b-inv-vazio">Nada guardado aqui.</li>
        {{/each}}
      </ol>
    </div>
    {{/each}}

    <p class="notes t20b-inv-dica"><i class="fa-solid fa-hand-pointer"></i> Arraste itens de fichas ou compêndios para cá para guardá-los no estoque do negócio.</p>
  </div>
</section>
